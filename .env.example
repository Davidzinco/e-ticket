# ==============================================================================
# E-TICKET SMASA — ENVIRONMENT VARIABLES CONFIGURATION TEMPLATE (.env.example)
# ==============================================================================
# Salin file ini menjadi .env atau .env.local:
#   cp .env.example .env.local
# JANGAN PERNAH meng-commit file .env atau .env.local yang berisi credential asli!
# ==============================================================================

# ==============================================================================
# 1. APPLICATION & BASE URLS
# ==============================================================================
# URL dasar aplikasi web. Digunakan untuk redirect, email callback, dan canonical URLs.
# - Development: http://localhost:3000
# - Production : https://e-coupon-bnc.vercel.app (atau custom domain Anda)
# Status: PUBLIC (Client-side & Server-side)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# NextAuth Canonical URL
# Digunakan oleh NextAuth untuk menangani session dan Google OAuth redirect.
# Status: SERVER-SIDE ONLY
NEXTAUTH_URL=http://localhost:3000

# Versi public dari NextAuth URL jika dibutuhkan di client-side
# Status: PUBLIC
NEXT_PUBLIC_NEXTAUTH_URL=http://localhost:3000

# Secret key acak untuk menandatangani JWT token NextAuth.
# Hasilkan dengan perintah terminal: openssl rand -base64 32
# Status: SERVER-SIDE ONLY
NEXTAUTH_SECRET=your_random_nextauth_secret_32_characters_long

# Nomor WhatsApp Official Panitia untuk tombol bantuan / kontak (format internasional tanpa + atau dengan +)
# Contoh: 08xxxxxxxxxxxxx
# Status: PUBLIC (Client-side)
NEXT_PUBLIC_SUPPORT_WHATSAPP=xxxxxxxxxxxxxxx

# ==============================================================================
# 2. FIREBASE WEB SDK (CLIENT-SIDE)
# ==============================================================================
# Dapatkan dari:
# Firebase Console (https://console.firebase.google.com/)
# > Project Settings > General > Your Apps > Web App > Firebase SDK snippet > Config
# Status: PUBLIC (Aman diekspos ke frontend)
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSy...
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=e-ticket-bnc.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=e-ticket-bnc
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=e-ticket-bnc.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789012
NEXT_PUBLIC_FIREBASE_APP_ID=1:123456789012:web:abcdef123456
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# ==============================================================================
# 3. FIREBASE ADMIN SDK (SERVER-SIDE ONLY)
# ==============================================================================
# Dapatkan dari:
# Firebase Console > Project Settings > Service accounts > Generate new private key
# Download file JSON dan salin isinya ke dua variabel berikut:
# Status: SERVER-SIDE ONLY (SANGAT RAHASIA! Jangan tambahkan prefix NEXT_PUBLIC_)

# Alamat email Service Account (misal: firebase-adminsdk-xxx@project-id.iam.gserviceaccount.com)
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@e-ticket-bnc.iam.gserviceaccount.com

# Private Key RSA Service Account.
# PERHATIAN: Masukkan kunci lengkap termasuk -----BEGIN PRIVATE KEY----- dan -----END PRIVATE KEY-----.
# Jika ditulis dalam satu baris, ganti baris baru dengan karakter literal \n.
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"

# ==============================================================================
# 4. DOKU PAYMENT GATEWAY (CHECKOUT INTEGRATION)
# ==============================================================================
# Dapatkan dari Dashboard DOKU:
# - Sandbox   : https://sandbox.doku.com/
# - Production: https://dashboard.doku.com/
# Menu: Settings > API Keys

# Mode Environment: "sandbox" atau "production"
# Status: SERVER-SIDE ONLY
DOKU_ENV=sandbox

# Client ID dari DOKU Merchant Dashboard
# Status: SERVER-SIDE ONLY
DOKU_CLIENT_ID=MCH-1234567890

# Secret Key Merchant DOKU (Digunakan untuk membuat HMAC-SHA256 Request Signature).
# JANGAN PERNAH memberi prefix NEXT_PUBLIC_!
# Status: SERVER-SIDE ONLY (SANGAT RAHASIA)
DOKU_SECRET_KEY=SK-abcdefghijklmnopqrstuvwxyz123456

# Notification Webhook URL: Endpoint backend website yang akan menerima HTTP POST notifikasi pembayaran dari DOKU.
# - Development: Gunakan URL tunneling (contoh: ngrok / cloudflared): https://xxxx.ngrok-free.app/api/doku/notification
# - Production : https://domain-anda.com/api/doku/notification
# Status: SERVER-SIDE ONLY
DOKU_NOTIFICATION_URL=http://localhost:3000/api/doku/notification

# Return / Success URL: URL tujuan redirect pembeli dari halaman hosted checkout DOKU setelah pembayaran selesai.
# Format: https://domain-anda.com/success
# Status: SERVER-SIDE ONLY
DOKU_RETURN_URL=http://localhost:3000/success

# Mode Bypass Pembayaran (KHUSUS TESTING LOKAL)
# Jika bernilai "true", server akan langsung menerbitkan tiket tanpa memanggil API DOKU (otomatis non-aktif di NODE_ENV=production).
# Status: SERVER-SIDE ONLY
PAYMENT_BYPASS=false

# ==============================================================================
# 5. GOOGLE OAUTH 2.0 (NEXTAUTH LOGIN ADMIN)
# ==============================================================================
# Dapatkan dari Google Cloud Console (https://console.cloud.google.com/):
# APIs & Services > Credentials > OAuth 2.0 Client IDs
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
# Status: SERVER-SIDE ONLY
GOOGLE_OAUTH_CLIENT_ID=123456789012-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=GOCSPX-xxxxxxxxxxxxxxxxxxxxxxxx

# ==============================================================================
# 6. GOOGLE SHEETS & DRIVE SYNC INTEGRATION
# ==============================================================================
# URL Web App Google Apps Script yang terhubung dengan Spreadsheet data tiket event.
# Dapatkan dari:
# Google Spreadsheet > Ekstensi > Apps Script > Terapkan (Deploy) > Kelola Penerapan > Salin URL Web App
# Status: SERVER-SIDE ONLY
GOOGLE_SHEETS_WEBHOOK_URL=https://script.google.com/macros/s/AKfycbw-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx/exec

# ==============================================================================
# 7. CONSOLE ADMIN AUTHENTICATION (BACKDOOR & ACCESS CODE)
# ==============================================================================
# Sistem Console Admin memiliki 2 metode akses tanpa tergantung Google OAuth:
# 1. Melalui halaman /myticket (Backdoor): Memasukkan email rahasia dan NIK rahasia berikut.
# 2. Melalui halaman /consol_admin (Access Code): Memasukkan kode akses rahasia.

# Email rahasia untuk backdoor /myticket
# Status: SERVER-SIDE ONLY
ADMIN_SECRET_EMAIL=admin@bnc.smasa.sch.id

# NIK rahasia untuk backdoor /myticket (16 digit angka)
# Status: SERVER-SIDE ONLY
ADMIN_SECRET_NIK=1234567890123456

# Kode akses untuk login form di /consol_admin
# Status: SERVER-SIDE ONLY
ADMIN_ACCESS_CODE=BNC2026@Gatepass

# Kunci rahasia untuk menandatangani HMAC cookie session bnc_admin_session (min 32 karakter)
# Hasilkan dengan: openssl rand -hex 32
# Status: SERVER-SIDE ONLY
ADMIN_SESSION_SECRET=a1b2c3d4e5f67890123456789abcdef0123456789abcdef0123456789abcdef0

# ==============================================================================
# 8. EMAIL NOTIFICATION (NODEMAILER SMTP GMAIL)
# ==============================================================================
# Digunakan untuk mengirim email konfirmasi pemesanan dan tiket QR Code (inline attachment) kepada pembeli.
# Dapatkan dari:
# Akun Google > Keamanan (Security) > Verifikasi 2 Langkah aktif > Sandi Aplikasi (App Passwords)
# Buat nama baru (misal: "BNC E-Ticket") dan salin 16 karakter password aplikasi.
# Status: SERVER-SIDE ONLY

# Email pengirim resmi
DEFAULT_EMAIL_USER_ADMIN=panitia.bnc@gmail.com

# Password aplikasi 16 karakter (tanpa spasi)
DEFAULT_EMAIL_PASSWORD_ADMIN=abcdefghijklmnop
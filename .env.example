# Application URLs
# Local: http://localhost:3000
# Production: use the Vercel domain, for example https://e-ticket.vercel.app
NEXT_PUBLIC_NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_URL=http://localhost:3000

# Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
NEXTAUTH_SECRET=replace_with_a_random_secret

# Firebase Web SDK
# Firebase Console > Project settings > General > Your apps > Web app
NEXT_PUBLIC_FIREBASE_API_KEY=replace_with_firebase_web_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=replace_with_messaging_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=replace_with_firebase_app_id

# Firebase Admin SDK
# Firebase Console > Project settings > Service accounts > Generate new private key
# Copy client_email and private_key from the downloaded JSON file.
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@example-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nreplace_with_private_key\n-----END PRIVATE KEY-----\n"

# Google OAuth
# Google Cloud Console > APIs & Services > Credentials > OAuth 2.0 Client ID
# Redirect URI local: http://localhost:3000/api/auth/callback/google
# Redirect URI production: https://your-domain.vercel.app/api/auth/callback/google
GOOGLE_OAUTH_CLIENT_ID=replace_with_google_oauth_client_id
GOOGLE_OAUTH_CLIENT_SECRET=replace_with_google_oauth_client_secret

# Midtrans Sandbox
# Midtrans Sandbox Dashboard > Settings > Access Keys
NEXT_PUBLIC_MIDTRANS_SNAP_URL=https://app.sandbox.midtrans.com/snap/snap.js
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY=SB-Mid-client-replace_me
MIDTRANS_CLIENT_KEY=SB-Mid-client-replace_me
MIDTRANS_SERVER_KEY=SB-Mid-server-replace_me

# Email sender (Gmail App Password, not the normal Gmail password)
# Google Account > Security > 2-Step Verification > App passwords
DEFAULT_EMAIL_USER_ADMIN=your-email@gmail.com
DEFAULT_EMAIL_PASSWORD_ADMIN=replace_with_16_character_app_password

